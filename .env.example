# CityPulse Environment Configuration
# Copy this file to .env and update with your actual values

########################################
# Database Configuration
########################################
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=citypulse

########################################
# Backboard AI Integration (KEEP SECRET)
########################################
BACKBOARD_API_KEY=your_api_key_here
ASSISTANT_ID=assistant_id_here

########################################
# Backend Configuration
########################################
# CORS allowed origins (comma-separated)
# Leave empty for development defaults (localhost:3000)
# For production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

########################################
# Frontend Configuration
########################################
# For local development: http://localhost:8000
# For production: https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
