# CityPulse Environment Configuration
# Copy to .env and fill in your values
# In CI, these are injected via GitHub Secrets

# Database
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=citypulse
POSTGRES_DB=citypulse

# Backend database URL (used when running API outside docker-compose)
# Local tools (host): use localhost
DATABASE_URL=postgresql://citypulse:citypulse@localhost:5432/citypulse
# Inside Docker: backend receives DATABASE_URL via docker-compose as
# postgresql://citypulse:citypulse@db:5432/citypulse

# Backboard AI Integration (keep secret, do not commit real values)
BACKBOARD_API_KEY=your-api-key-here
# Optional: workflow ID and API URL if you need to override defaults
BACKBOARD_WORKFLOW_ID=
BACKBOARD_API_URL=https://api.backboard.ai

# Frontend API URL
VITE_API_URL=http://localhost:8000
