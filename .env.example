# CityPulse Environment Configuration
# Copy this file to .env and update with your actual values

########################################
# Database Configuration
########################################
# Used by Docker Compose to create the database
POSTGRES_USER=citypulse
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=citypulse

# Backend connection string
# - For Docker: uses service name 'db' (set automatically in docker-compose.yml)
# - For local dev (outside Docker): use localhost:5432
DATABASE_URL=postgresql://citypulse:CHANGE_ME_IN_PRODUCTION@localhost:5432/citypulse

########################################
# Backboard AI Integration (REQUIRED)
########################################
# Get your API key from https://backboard.ai
BACKBOARD_API_KEY=your_api_key_here

# Optional: Backboard AI Assistant ID
# If not set, the system will auto-create an assistant named "CPAssistant"
# Run: docker compose exec backend python -m app.ai_workflow.assistant
ASSISTANT_ID=

# Optional: Override API URL (defaults to https://api.backboard.ai)
BACKBOARD_API_URL=https://api.backboard.ai

########################################
# Backend Configuration
########################################
# CORS allowed origins (comma-separated)
# - Leave empty for development (allows localhost:3000, 127.0.0.1:3000)
# - For production: set to your frontend URL(s)
# Example: CORS_ORIGINS=https://citypulse.com,https://www.citypulse.com
CORS_ORIGINS=

# Optional: Enable debug mode (shows detailed error messages)
DEBUG=false

########################################
# Frontend Configuration
########################################
# API base URL that the frontend will connect to
# - For Docker development: http://localhost:8000
# - For local development: http://localhost:8000
# - For production: https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
